# Server-only Meta Graph API configuration. Never use NEXT_PUBLIC_ for tokens.
# Select a supported API version from your Meta app dashboard (format: vNN.N).
META_GRAPH_API_VERSION=
# Use the Page ID returned by the API, which may differ from the public profile ID.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Instagram professional account linked to the Facebook Page.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Facebook Login USER token with Instagram read access (not an Instagram Login token).
INSTAGRAM_ACCESS_TOKEN=
